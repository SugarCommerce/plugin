{
  "name": "sugarcommerce/plugin",
  "description": "Boot a WordPress plugin only when its PHP, WordPress and plugin requirements are met, say plainly when they are not, and enqueue the CSS and JavaScript a Composer package ships.",
  "type": "library",
  "license": "GPL-2.0-or-later",
  "homepage": "https://github.com/sugarcommerce/plugin",
  "authors": [
    {
      "name": "David Sherlock",
      "homepage": "https://arraypress.com/"
    }
  ],
  "require": {
    "php": ">=8.3"
  },
  "autoload": {
    "psr-4": {
      "SugarCommerce\\Plugin\\": "src/"
    }
  },
  "config": {
    "optimize-autoloader": true,
    "sort-packages": true,
    "preferred-install": "dist",
    "allow-plugins": {
      "dealerdirect/phpcodesniffer-composer-installer": false
    }
  },
  "minimum-stability": "dev",
  "prefer-stable": true,
  "support": {
    "issues": "https://github.com/sugarcommerce/plugin/issues",
    "source": "https://github.com/sugarcommerce/plugin"
  },
  "keywords": [
    "wordpress",
    "plugin",
    "requirements",
    "bootstrap",
    "assets",
    "composer"
  ],
  "require-dev": {
    "phpcompatibility/phpcompatibility-wp": "^2.1",
    "phpunit/phpunit": "^12.0",
    "squizlabs/php_codesniffer": "^3.13.5",
    "wp-coding-standards/wpcs": "^3.4"
  },
  "autoload-dev": {
    "psr-4": {
      "SugarCommerce\\Plugin\\Tests\\": "tests/"
    },
    "exclude-from-classmap": [
      "/tests/bootstrap.php",
      "/tests/stubs/"
    ]
  },
  "scripts": {
    "test": "phpunit",
    "lint": "phpcs",
    "format": "phpcbf --standard=phpcs-format.xml.dist",
    "format:check": "phpcs --standard=phpcs-format.xml.dist"
  }
}
